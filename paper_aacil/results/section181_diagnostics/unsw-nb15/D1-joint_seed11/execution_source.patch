@@ -0,0 +1,80 @@
+"""UNSW §181 post-hoc diagnostics; same model/evaluation entry as §165 C1."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--method', required=True,
+                   choices=('D1-joint', 'D2-matched', 'D3-memory2x', 'D3-memory4x'))
+    p.add_argument('--seed', required=True, type=int, choices=(1, 10, 11, 12, 13, 14))
+    p.add_argument('--data-root', required=True, type=Path)
+    p.add_argument('--output-root', required=True, type=Path)
+    p.add_argument('--smoke', action='store_true')
+    p.add_argument('--resume', action='store_true')
+    a = p.parse_args()
+    if (a.seed == 1) != a.smoke:
+        p.error('Smoke uses seed1; formal diagnostic uses seeds10-14')
+    wd = Path('EXPERIMENT_ROOT').resolve(strict=True)
+    for path in (a.data_root.resolve(strict=True), a.output_root.resolve()):
+        if not path.is_relative_to(wd):
+            p.error('Data and outputs must be inside the mounted WD workspace')
+    os.environ.update(OMP_NUM_THREADS='2', MKL_NUM_THREADS='2',
+                      TEMP=str(wd / 'tmp'), TMP=str(wd / 'tmp'))
+    import torch
+    from ncd.prepare_problem_scout_data import prepare_setting
+    from ncd.run_problem_scout import binding, save_json, smoke_subset
+    from ncd.section138_cell import run_cell
+    from ncd.section156_config import configurations
+    from ncd.section156_models import build_models, train_gate
+    from ncd.source_commit import source_commit
+    torch.set_num_threads(2)
+    torch.set_num_interop_threads(1)
+    cfg = next(c for c in configurations() if c.identifier == 'C1')
+    config = json.loads((ROOT / 'ncd/configs/problem_scout_section21.json').read_text())
+    config.update(problem_scout_data_root=str(a.data_root.resolve()), device='cpu',
+        cpu_threads=2, smoke=a.smoke, lambda_g=0., epochs_per_task=1 if a.smoke else 8,
+        min_steps_per_task=0 if a.smoke else 2000, batch_size=256, eval_batch_size=4096,
+        learning_rate=.001, derpp_alpha=1., derpp_beta=1., deadline_iso=None,
+        normal_training_rows=50000, ema_decay=.999, ema_consistency=1., hidden=128,
+        section156=cfg.switches(), section165_memory='exact_c1',
+        section181_diagnostic=a.method)
+    output = a.output_root.resolve() / ('smoke' if a.smoke else 'diagnostic') / a.method / f'seed{a.seed}'
+    output.mkdir(parents=True, exist_ok=a.resume)
+    started = time.perf_counter()
+    data, _, _, _ = prepare_setting('UNSW-NB15', config)
+    if a.smoke:
+        data, _, _ = smoke_subset(data, None, None, limit=64)
+    files = ('ncd/run_section181.py', 'ncd/section181_diagnostics.py', 'ncd/section138_cell.py',
+             'ncd/section156_config.py', 'ncd/section156_models.py', 'ncd/section81_exposure.py',
+             'ncd/run_aacil.py', 'ncd/run_problem_scout.py', 'ncd/prepare_problem_scout_data.py')
+    hashes = {f: hashlib.sha256((ROOT / f).read_bytes()).hexdigest() for f in files}
+    identity = dict(git_commit=source_commit(ROOT), dataset='UNSW-NB15', seed=a.seed,
+        method=a.method, effective_config=config, data_binding=binding(data, None, None),
+        command=[s for s in sys.argv if s != '--resume'], output_role='post_hoc_diagnostic',
+        smoke=a.smoke, source_sha256=hashes, post_hoc=True,
+        scope='RQ2 diagnostic only; no changes to S1/R1-R5 or locked RQ1/RQ3',
+        d2_semantics='Current attack quota includes optimization and stopping slots; both are subsampled',
+        d1_semantics='All seen optimization-eligible TRAIN; common stopping/calibration held out; offline reference',
+        log_paths=[str(wd / 'logs' / f'section181-{a.method}-seed{a.seed}{suffix}.log')
+                   for suffix in ('.stdout', '.stderr')])
+    def trainer(model, x, y, *, schedule, **kwargs):
+        return train_gate(model, x, y, kind='histgb', **kwargs)
+    result = run_cell(data, config, identity, output / 'cell', cfg,
+                      model_builder=build_models, gate_trainer=trainer)
+    save_json(output / 'summary.json', dict(completed=True, scientific_result=not a.smoke,
+        post_hoc=True, source_commit=identity['git_commit'], dataset='UNSW-NB15', seed=a.seed,
+        method=a.method, checkpoints=len(result['checkpoints']),
+        elapsed_seconds=time.perf_counter()-started))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ncd/section181_diagnostics.py b/ncd/section181_diagnostics.py
new file mode 100644
index 0000000..0f645e3
--- /dev/null
+++ b/ncd/section181_diagnostics.py
@@ -0,0 +1,48 @@
+"""Post-hoc §181 data-access interventions on exact-C1 AR-Stateless.
+
+D1 is an offline all-seen optimization-pool reference, not a deployment method
+or guaranteed numerical upper bound. TRAIN stopping/calibration roles stay held
+out. D2 caps new attack optimization AND stopping rows at the same split of the
+current attack-memory quota. D3 multiplies the total attack-only budget before
+integer allocation (including the transferred benign share).
+"""
+import numpy as np
+
+from ncd import run_aacil as aa
+
+METHODS = ("D1-joint", "D2-matched", "D3-memory2x", "D3-memory4x")
+
+
+def targets(method, seen, normal):
+    if method not in METHODS:
+        raise ValueError("Unknown section181 intervention")
+    multiplier = {"D3-memory2x": 2, "D3-memory4x": 4}.get(method, 1)
+    attacks = sorted(c for c in seen if c != normal)
+    base, remainder = divmod(200 * multiplier * len(seen), len(attacks))
+    return {c: base + int(j < remainder) for j, c in enumerate(attacks)}
+
+
+def slot(data, train_ids, validation_ids):
+    return {"train_ids": train_ids.copy(), "validation_ids": validation_ids.copy(),
+            "train_x": data.x_train[train_ids].copy(),
+            "validation_x": data.x_train[validation_ids].copy()}
+
+
+def intervene(method, data, exposure, current, slots, seen, new, task_seed):
+    normal = exposure.normal
+    quotas = targets(method, seen, normal)
+    if method == "D1-joint":
+        slots = {c: slot(data, exposure.train[c], exposure.valid[c])
+                 for c in seen if c != normal}
+        train = exposure.train[normal]
+        train = train[~np.isin(train, exposure.normal_stopping_ids)]
+        slots[normal] = slot(data, train, exposure.normal_stopping_ids)
+    elif method == "D2-matched":
+        slots = dict(slots)
+        for c in new:
+            nt, nv = aa.slot_split(quotas[c])
+            rng = task_seed * 10007 + c
+            slots[c] = slot(data,
+                aa.select_rows(current[c]["train_ids"], nt, rng),
+                aa.select_rows(current[c]["validation_ids"], nv, rng + 53))
+    return slots, quotas
