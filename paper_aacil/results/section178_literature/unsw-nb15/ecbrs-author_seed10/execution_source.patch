--- /dev/null
+++ b/ncd/ecbrs_author_memory.py
@@ -0,0 +1,144 @@
+"""Separately identified author-memory sensitivity, not native training.
+
+Control flow follows memory_update and retrieve_replaysamples(local_store=False)
+at amalapuram/CLbasedNIDS commit 0fa7ac97ff441a865ed89aad69f05fc7e2eb7840,
+codebase/utils/buffermemory.py. UNSW minority_allocation=.1 is from that
+commit's codebase/utils/config/configurations.py. No paper-gamma substitution.
+
+Explicit adaptations: row IDs instead of feature arrays; no native task-0
+initialization/skip gate; growing matched-protocol capacity; corrected append
+index (len-1, whereas the upstream underfill branch stores len); RNGs isolated
+and checkpointed. Encounter counts are advanced for the whole incoming batch
+before replacement, as in the author's caller. Training remains separately
+specified and must not be called an exact native-binary reproduction.
+"""
+import copy
+import random
+import numpy as np
+
+
+SEMANTICS = dict(implementation='author_memory_control_flow_matched_protocol',
+    author_commit='0fa7ac97ff441a865ed89aad69f05fc7e2eb7840',
+    minority_allocation=0.1, full='persistent selected victims only',
+    victim='global majority above integer minority allocation; otherwise non-majority local max; upstream insertion-order ties',
+    retrieval='inverse local count with upstream global-majority-at-exact-allocation weight=1; cached priorities',
+    adaptations=['row-ID payload', 'corrected underfill append index',
+        'no native task-0 skip or prefill', 'monotone matched-protocol capacity',
+        'isolated Python Random and legacy NumPy RandomState'])
+
+
+class AuthorCodeMemory:
+    def __init__(self, capacity, seed=0):
+        if not isinstance(capacity, int) or capacity < 1:
+            raise ValueError('positive integer capacity required')
+        self.capacity = capacity
+        self.rows, self.labels = [], []
+        self.local_count, self.local_store, self.encounters = {}, {}, {}
+        self.full, self.global_priority = set(), {}
+        self.rng = random.Random(seed)
+        self.np_rng = np.random.RandomState(seed)
+
+    def counts(self):
+        return dict(self.local_count)
+
+    def threshold(self):
+        return dict(minority_allocation=.1, majority_count_floor=int(.1*self.capacity))
+
+    def grow(self, capacity):
+        if not isinstance(capacity, int) or capacity < self.capacity:
+            raise ValueError('capacity cannot decrease')
+        self.capacity = capacity
+
+    def offer_batch(self, rows, labels):
+        if len(rows) != len(labels):
+            raise ValueError('row/label size mismatch')
+        rows, labels = list(rows), list(labels)
+        if any(not isinstance(x, (int, np.integer)) or x < 0 for x in rows+labels):
+            raise ValueError('nonnegative integer row IDs and labels required')
+        rows, labels = list(map(int, rows)), list(map(int, labels))
+        for c in labels:
+            self.encounters[c] = self.encounters.get(c, 0)+1
+        for row, c in zip(rows, labels):
+            if len(self.rows) < self.capacity:
+                index = len(self.rows)
+                self.rows.append(row)
+                self.labels.append(c)
+                self.local_count[c] = self.local_count.get(c, 0)+1
+                self.local_store.setdefault(c, []).append(index)
+                continue
+            if c not in self.full:
+                total = sum(self.encounters.values())
+                # Match the integer-label set iteration used by classes_so_far.
+                for k in set(self.encounters):
+                    if k in self.local_count:
+                        self.global_priority[k] = self.encounters[k]/total
+                maximum = max(self.global_priority.values())
+                major = max(self.global_priority, key=self.global_priority.get)
+                others = [k for k in self.local_count if k != major]
+                victim = others[0] if others else c
+                for k in others:
+                    if self.local_count[k] >= self.local_count.get(victim, 0):
+                        victim = k
+                temp = min(self.global_priority.values())
+                for k, count in self.local_count.items():
+                    if self.global_priority[k] >= temp and self.global_priority[k] == maximum and count > int(.1*self.capacity):
+                        victim, temp = k, self.global_priority[k]
+                if self.global_priority[victim] != maximum:
+                    current_max = self.local_count[others[0]]
+                    for k in others:
+                        if self.local_count[k] > current_max:
+                            victim, current_max = k, self.local_count[k]
+                self.full.add(victim)
+                members = self.local_store[victim]
+                index = members[self.rng.randint(0, len(members)-1)]
+                self.local_count[victim] -= 1
+                self.local_count[c] = self.local_count.get(c, 0)+1
+                self.local_store[victim].remove(index)
+                self.local_store.setdefault(c, []).append(index)
+            else:
+                if self.rng.uniform(0, 1) > self.local_count[c]/self.encounters[c]:
+                    continue
+                # Upstream chooses the first stored slot, not a uniform slot.
+                index = self.local_store[c][0]
+            self.rows[index], self.labels[index] = row, c
+
+    def sample(self, size):
+        if not isinstance(size, int) or size < 0:
+            raise ValueError('nonnegative integer replay size required')
+        n = min(size, len(self.rows))
+        if not n:
+            return np.empty(0, dtype=np.int64), np.empty(0, dtype=np.int64)
+        maximum = max(self.global_priority.values(), default=None)
+        weights = [1. if c in self.global_priority and self.global_priority[c] == maximum
+            and self.local_count[c] == .1*self.capacity else 1/self.local_count[c] for c in self.labels]
+        weights = np.asarray(weights, dtype=float)
+        indices = self.np_rng.choice(len(self.rows), n, replace=False, p=weights/weights.sum())
+        return np.asarray(self.rows, dtype=np.int64)[indices], np.asarray(self.labels, dtype=np.int64)[indices]
+
+    def state(self):
+        rng = self.np_rng.get_state()
+        return copy.deepcopy(dict(capacity=self.capacity, rows=self.rows, labels=self.labels,
+            local_count=self.local_count, local_store=self.local_store, encounters=self.encounters,
+            full=sorted(self.full), global_priority=self.global_priority,
+            rng=self.rng.getstate(), np_rng=[rng[0], rng[1].tolist(), rng[2], rng[3], rng[4]], semantics=SEMANTICS))
+
+    @classmethod
+    def restore(cls, state):
+        state = copy.deepcopy(state)
+        if state['semantics'] != SEMANTICS:
+            raise ValueError('memory semantics changed')
+        obj = cls(state['capacity'])
+        for k in ['rows', 'labels', 'local_count', 'local_store', 'encounters', 'global_priority']:
+            setattr(obj, k, state[k])
+        obj.full = set(state['full'])
+        obj.rng.setstate(state['rng'])
+        s = state['np_rng']
+        obj.np_rng.set_state((s[0], np.asarray(s[1], dtype=np.uint32), s[2], s[3], s[4]))
+        assert len(obj.rows) == len(obj.labels) <= obj.capacity
+        assert set(obj.local_count) <= set(obj.encounters)
+        assert obj.full <= set(obj.local_count)
+        for c, count in obj.local_count.items():
+            assert count == obj.labels.count(c) == len(obj.local_store[c])
+            assert all(obj.labels[i] == c for i in obj.local_store[c])
+        assert sorted(i for ids in obj.local_store.values() for i in ids) == list(range(len(obj.rows)))
+        return obj
diff --git a/ncd/run_section178_ecbrs_author.py b/ncd/run_section178_ecbrs_author.py
new file mode 100644
--- /dev/null
+++ b/ncd/run_section178_ecbrs_author.py
@@ -0,0 +1,181 @@
+"""Matched-protocol ECBRS author-memory sensitivity, with checkpoint resume.
+
+This does not reproduce the authors' binary training entry. The registered
+multiclass MLP, task schedule, permanent benign holdout and evaluation apply.
+Author-memory control flow and all adaptation choices are saved in identity.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+import numpy as np
+import torch
+from ncd import run_problem_scout as ps, run_replay_bs as bs
+from ncd.crr_benchmarks import training_epoch_batches, _class_balanced_cross_entropy
+from ncd.default_decision import evaluate_models
+from ncd.ecbrs_author_memory import AuthorCodeMemory, SEMANTICS
+from ncd.model import MLP
+from ncd.prepare_problem_scout_data import prepare_setting
+from ncd.source_commit import source_commit
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--dataset', choices=['UNSW-NB15'], required=True)
+    p.add_argument('--seed', type=int, choices=range(10, 15), required=True)
+    p.add_argument('--data-root', type=Path, required=True)
+    p.add_argument('--output-dir', type=Path, required=True)
+    p.add_argument('--log-prefix', type=Path, required=True)
+    p.add_argument('--smoke', action='store_true')
+    p.add_argument('--resume', action='store_true')
+    a = p.parse_args()
+    wd = Path('@@EXPERIMENT_ROOT@@').resolve(strict=True)
+    if any(not path.is_relative_to(wd) for path in
+           (a.data_root.resolve(strict=True), a.output_dir.resolve(), a.log_prefix.resolve())):
+        p.error('Data and outputs must be on the existing WD workspace')
+    os.environ['TEMP'] = os.environ['TMP'] = str(wd/'tmp')
+    torch.set_num_threads(2)
+    torch.set_num_interop_threads(1)
+    selection = json.loads((ROOT/'paper_aacil/results/section123_schedule_selection.json').read_text(encoding='utf-8'))
+    if selection['selected_schedule'] != 'original_fixed':
+        p.error('Registered original_fixed schedule required')
+    config = json.loads((ROOT/'ncd/configs/problem_scout_section21.json').read_text(encoding='utf-8'))
+    config.update(problem_scout_data_root=str(a.data_root.resolve()), hidden=128, hidden_layers=2,
+        device='cpu', cpu_threads=2, epochs_per_task=1 if a.smoke else 8,
+        min_steps_per_task=0 if a.smoke else 2000, learning_rate=.001, batch_size=256,
+        smoke=a.smoke, buffer_per_class=200)
+    data, _, _, metadata = prepare_setting(a.dataset, config)
+    original_counts = np.bincount(data.y_train, minlength=len(data.class_order))
+    if a.smoke:
+        data, _, _ = ps.smoke_subset(data, None, None, limit=64)
+    train, valid = ps.section26_pools(data, a.seed)
+    source_files = ['ncd/run_section178_ecbrs_author.py', 'ncd/ecbrs_author_memory.py',
+        'ncd/run_problem_scout.py', 'ncd/run_replay_bs.py', 'ncd/crr_benchmarks.py',
+        'ncd/default_decision.py', 'ncd/model.py', 'ncd/prepare_problem_scout_data.py']
+    identity = dict(git_commit=source_commit(ROOT), dataset=a.dataset, method='ecbrs-author-code-sensitivity',
+        seed=a.seed, smoke=a.smoke, effective_config=config, tasks=data.tasks,
+        class_order=data.class_order, data_binding=ps.binding(data, None, None),
+        data_metadata_sha256=ps.canonical_hash(metadata),
+        command=[v for v in sys.argv if v != '--resume'],
+        source_sha256={f: ps.digest(ROOT/f) for f in source_files},
+        original_train_counts=original_counts.tolist(), memory_semantics=SEMANTICS,
+        implementation_scope='Fixed-author memory control-flow port with declared underfill-index correction and matched-protocol initialization/growth, adapted to multiclass training; not native binary entry execution.',
+        author_code='https://github.com/amalapuram/CLbasedNIDS/tree/0fa7ac97ff441a865ed89aad69f05fc7e2eb7840',
+        author_difference='This separate sensitivity uses author minority_allocation=.1, selected-victim full updates, cached-priority retrieval and first-slot full replacement; paper-literal results remain unchanged.',
+        adaptations=['Same 2x128 MLP, Adam, eight epochs / minimum 2000 steps per task as the registered neural comparison.',
+            'A single class-balanced multiclass CE on concatenated stream and author-weighted replay; native binary BCE is not used.',
+            'Each current-task presentation is a stream encounter including epoch repeats; counts advance for the whole batch before memory replacement. Replay is not re-counted or re-admitted.',
+            'Budget grows to 200 times seen classes including Normal; old discarded examples are never replenished.',
+            'Author UNSW minority_allocation=.1 is retained; native mem6666/replay5000/five-epoch binary training is not reproduced.',
+            'Author underfill local_store append index is corrected to len-1. Native task-0 prefill/skip gate is replaced by empty matched-protocol initialization.',
+            'Parity against fixed upstream memory_update/retrieve functions covers full-buffer transitions; this is not end-to-end native-training equivalence.'],
+        holdout={str(c): dict(train_count=len(train[c]), validation_count=len(valid[c]),
+            validation_indices_sha256=hashlib.sha256(valid[c].tobytes()).hexdigest()) for c in valid},
+        log_paths=[str(a.log_prefix.resolve())+f'.{s}.log' for s in ('stdout','stderr')])
+    out = a.output_dir.resolve()
+    out.mkdir(parents=True, exist_ok=a.resume)
+    if (out/'identity.json').exists():
+        assert json.loads((out/'identity.json').read_text()) == identity, 'Resume identity mismatch'
+    else:
+        ps.save_json(out/'identity.json', identity)
+    if (out/'result.json').exists():
+        completed = json.loads((out/'result.json').read_text(encoding='utf-8'))
+        assert completed['completed'] and completed['identity'] == identity
+        assert len(completed['checkpoints']) == len(data.tasks)
+        for cp in completed['checkpoints']:
+            assert ps.digest(out/cp['checkpoint_file']) == cp['checkpoint_sha256']
+        assert json.loads((out/'summary.json').read_text())['completed']
+        print('CELL_RESUME_COMPLETE_VALIDATED_NO_OVERWRITE', flush=True)
+        return
+    started_all = time.perf_counter()
+    memory = AuthorCodeMemory(200*len(data.tasks[0]), seed=a.seed)
+    ps.seed_everything(a.seed*10000)
+    model = MLP(data.x_train.shape[1], 128, len(data.class_order))
+    records, defaults, calibrated = [], [], []
+    cumulative = 0.
+    for t, task in enumerate(data.tasks):
+        seen = [c for part in data.tasks[:t+1] for c in part]
+        task_seed = a.seed*10000+t
+        ps.seed_everything(task_seed)
+        checkpoint = out/f'checkpoints/checkpoint_{t:03d}.pt'
+        if checkpoint.exists():
+            state = ps.checkpoint_load(checkpoint, identity)
+            assert state['task_index'] == t and state['seen_classes'] == seen
+            model.load_state_dict(state['model_state'])
+            memory = AuthorCodeMemory.restore(state['memory'])
+            cumulative = state['training_seconds_cumulative']
+            print(f'CHECKPOINT_RESUME task={t}', flush=True)
+        else:
+            memory.grow(200*len(seen))
+            current = np.sort(np.concatenate([train[c] for c in task]))
+            optimizer = torch.optim.Adam(model.parameters(), lr=.001)
+            stats = {}
+            before = len(memory.rows)
+            start = time.perf_counter()
+            print(f'CHECKPOINT_TRAINING task={t} current_rows={len(current)} replay_rows={before}', flush=True)
+            for epoch, batches in training_epoch_batches(current[:, None], data.y_train[current], 256,
+                    task_seed, config['epochs_per_task'], config['min_steps_per_task'], stats):
+                model.train()
+                for ids, labels in batches:
+                    current_ids = ids[:, 0].numpy()
+                    replay_ids, replay_labels = memory.sample(256)
+                    assert np.array_equal(data.y_train[replay_ids], replay_labels)
+                    joined = np.concatenate([current_ids, replay_ids])
+                    x = torch.from_numpy(np.asarray(data.x_train[joined]))
+                    y = torch.from_numpy(np.asarray(data.y_train[joined]))
+                    optimizer.zero_grad(set_to_none=True)
+                    loss = _class_balanced_cross_entropy(model(x), y)
+                    if not torch.isfinite(loss):
+                        raise ValueError('Nonfinite loss')
+                    loss.backward()
+                    optimizer.step()
+                    memory.offer_batch(current_ids, labels.numpy())
+                print(f'EPOCH_DONE task={t} epoch={epoch+1} memory_rows={len(memory.rows)}', flush=True)
+            seconds = time.perf_counter()-start
+            cumulative += seconds
+            state = dict(identity=identity, task_index=t, seen_classes=seen,
+                model_state={k: v.detach().cpu().clone() for k, v in model.state_dict().items()},
+                memory=memory.state(), training_seconds=seconds, training_seconds_cumulative=cumulative,
+                training_schedule=stats, replay_examples_before=before, replay_examples_after=len(memory.rows),
+                current_rows_sha256=hashlib.sha256(current.tobytes()).hexdigest(), current_rows=len(current),
+                memory_class_counts=memory.counts(), memory_threshold=memory.threshold())
+            ps.checkpoint_save(checkpoint, state)
+        # Explicitly validate permanent holdout exclusion and memory ownership.
+        rows = np.asarray(memory.rows, dtype=np.int64)
+        held = np.concatenate(list(valid.values()))
+        assert not np.intersect1d(rows, held).size and len(rows) <= 200*len(seen)
+        assert np.array_equal(data.y_train[rows], np.asarray(memory.labels))
+        assert set(memory.labels).issubset(seen)
+        model.eval()
+        default = evaluate_models(data.x_test, data.y_test, seen, data.class_order, model)
+        calibration, points, cal_seconds, eval_seconds = bs.evaluate(model, data, seen,
+            valid[data.class_order.index('Normal')], original_counts, config, torch.device('cpu'))
+        cp_hash = ps.digest(checkpoint)
+        record = {k: state[k] for k in ('task_index', 'seen_classes', 'training_seconds',
+            'training_seconds_cumulative', 'training_schedule', 'replay_examples_before', 'replay_examples_after',
+            'current_rows_sha256', 'current_rows', 'memory_class_counts', 'memory_threshold')}
+        record.update(checkpoint_file=checkpoint.relative_to(out).as_posix(), checkpoint_sha256=cp_hash,
+            identity_hash=ps.canonical_hash(identity))
+        ps.save_json(checkpoint.with_suffix('.json'), record)
+        records.append(record)
+        defaults.append(dict(task_index=t, checkpoint_sha256=cp_hash, metrics=default))
+        calibrated.append(dict(task_index=t, checkpoint_sha256=cp_hash, calibration=calibration,
+            operating_points=points, calibration_seconds=cal_seconds, evaluation_seconds=eval_seconds))
+        print(f'CHECKPOINT_EVALUATED task={t}', flush=True)
+    ps.save_json(out/'result.json', dict(completed=True, scientific_result=not a.smoke,
+        identity=identity, checkpoints=records, default_stages=defaults, calibrated_stages=calibrated,
+        training_seconds_total=cumulative))
+    ps.save_json(out/'summary.json', dict(completed=True, scientific_result=not a.smoke,
+        method=identity['method'], seed=a.seed, smoke=a.smoke, checkpoints=len(records),
+        elapsed_seconds=time.perf_counter()-started_all, training_seconds_total=cumulative))
+    print('CELL_COMPLETE', flush=True)
+
+
+if __name__ == '__main__':
+    main()
