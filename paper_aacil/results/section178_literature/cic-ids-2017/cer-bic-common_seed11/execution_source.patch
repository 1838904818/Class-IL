+++ b/ncd/section181_diagnostics.py
@@ -0,0 +1,48 @@
+"""Post-hoc §181 data-access interventions on exact-C1 AR-Stateless.
+
+D1 is an offline all-seen optimization-pool reference, not a deployment method
+or guaranteed numerical upper bound. TRAIN stopping/calibration roles stay held
+out. D2 caps new attack optimization AND stopping rows at the same split of the
+current attack-memory quota. D3 multiplies the total attack-only budget before
+integer allocation (including the transferred benign share).
+"""
+import numpy as np
+
+from ncd import run_aacil as aa
+
+METHODS = ("D1-joint", "D2-matched", "D3-memory2x", "D3-memory4x")
+
+
+def targets(method, seen, normal):
+    if method not in METHODS:
+        raise ValueError("Unknown section181 intervention")
+    multiplier = {"D3-memory2x": 2, "D3-memory4x": 4}.get(method, 1)
+    attacks = sorted(c for c in seen if c != normal)
+    base, remainder = divmod(200 * multiplier * len(seen), len(attacks))
+    return {c: base + int(j < remainder) for j, c in enumerate(attacks)}
+
+
+def slot(data, train_ids, validation_ids):
+    return {"train_ids": train_ids.copy(), "validation_ids": validation_ids.copy(),
+            "train_x": data.x_train[train_ids].copy(),
+            "validation_x": data.x_train[validation_ids].copy()}
+
+
+def intervene(method, data, exposure, current, slots, seen, new, task_seed):
+    normal = exposure.normal
+    quotas = targets(method, seen, normal)
+    if method == "D1-joint":
+        slots = {c: slot(data, exposure.train[c], exposure.valid[c])
+                 for c in seen if c != normal}
+        train = exposure.train[normal]
+        train = train[~np.isin(train, exposure.normal_stopping_ids)]
+        slots[normal] = slot(data, train, exposure.normal_stopping_ids)
+    elif method == "D2-matched":
+        slots = dict(slots)
+        for c in new:
+            nt, nv = aa.slot_split(quotas[c])
+            rng = task_seed * 10007 + c
+            slots[c] = slot(data,
+                aa.select_rows(current[c]["train_ids"], nt, rng),
+                aa.select_rows(current[c]["validation_ids"], nv, rng + 53))
+    return slots, quotas
