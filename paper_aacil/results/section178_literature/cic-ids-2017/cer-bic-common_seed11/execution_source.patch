+"""Separately identified author-memory sensitivity, not native training.
+
+Control flow follows memory_update and retrieve_replaysamples(local_store=False)
+at amalapuram/CLbasedNIDS commit 0fa7ac97ff441a865ed89aad69f05fc7e2eb7840,
+codebase/utils/buffermemory.py. UNSW minority_allocation=.1 is from that
+commit's codebase/utils/config/configurations.py. No paper-gamma substitution.
+
+Explicit adaptations: row IDs instead of feature arrays; no native task-0
+initialization/skip gate; growing matched-protocol capacity; corrected append
+index (len-1, whereas the upstream underfill branch stores len); RNGs isolated
+and checkpointed. Encounter counts are advanced for the whole incoming batch
+before replacement, as in the author's caller. Training remains separately
+specified and must not be called an exact native-binary reproduction.
+"""
+import copy
+import random
+import numpy as np
+
+
+SEMANTICS = dict(implementation='author_memory_control_flow_matched_protocol',
+    author_commit='0fa7ac97ff441a865ed89aad69f05fc7e2eb7840',
+    minority_allocation=0.1, full='persistent selected victims only',
+    victim='global majority above integer minority allocation; otherwise non-majority local max; upstream insertion-order ties',
+    retrieval='inverse local count with upstream global-majority-at-exact-allocation weight=1; cached priorities',
+    adaptations=['row-ID payload', 'corrected underfill append index',
+        'no native task-0 skip or prefill', 'monotone matched-protocol capacity',
+        'isolated Python Random and legacy NumPy RandomState'])
+
+
+class AuthorCodeMemory:
+    def __init__(self, capacity, seed=0):
+        if not isinstance(capacity, int) or capacity < 1:
+            raise ValueError('positive integer capacity required')
+        self.capacity = capacity
+        self.rows, self.labels = [], []
+        self.local_count, self.local_store, self.encounters = {}, {}, {}
+        self.full, self.global_priority = set(), {}
+        self.rng = random.Random(seed)
+        self.np_rng = np.random.RandomState(seed)
+
+    def counts(self):
+        return dict(self.local_count)
+
+    def threshold(self):
+        return dict(minority_allocation=.1, majority_count_floor=int(.1*self.capacity))
+
+    def grow(self, capacity):
+        if not isinstance(capacity, int) or capacity < self.capacity:
+            raise ValueError('capacity cannot decrease')
+        self.capacity = capacity
+
+    def offer_batch(self, rows, labels):
+        if len(rows) != len(labels):
+            raise ValueError('row/label size mismatch')
+        rows, labels = list(rows), list(labels)
+        if any(not isinstance(x, (int, np.integer)) or x < 0 for x in rows+labels):
+            raise ValueError('nonnegative integer row IDs and labels required')
+        rows, labels = list(map(int, rows)), list(map(int, labels))
+        for c in labels:
+            self.encounters[c] = self.encounters.get(c, 0)+1
+        for row, c in zip(rows, labels):
+            if len(self.rows) < self.capacity:
+                index = len(self.rows)
+                self.rows.append(row)
+                self.labels.append(c)
+                self.local_count[c] = self.local_count.get(c, 0)+1
+                self.local_store.setdefault(c, []).append(index)
+                continue
+            if c not in self.full:
+                total = sum(self.encounters.values())
+                # Match the integer-label set iteration used by classes_so_far.
+                for k in set(self.encounters):
+                    if k in self.local_count:
+                        self.global_priority[k] = self.encounters[k]/total
+                maximum = max(self.global_priority.values())
+                major = max(self.global_priority, key=self.global_priority.get)
+                others = [k for k in self.local_count if k != major]
+                victim = others[0] if others else c
+                for k in others:
+                    if self.local_count[k] >= self.local_count.get(victim, 0):
+                        victim = k
+                temp = min(self.global_priority.values())
+                for k, count in self.local_count.items():
+                    if self.global_priority[k] >= temp and self.global_priority[k] == maximum and count > int(.1*self.capacity):
+                        victim, temp = k, self.global_priority[k]
+                if self.global_priority[victim] != maximum:
+                    current_max = self.local_count[others[0]]
+                    for k in others:
+                        if self.local_count[k] > current_max:
+                            victim, current_max = k, self.local_count[k]
+                self.full.add(victim)
+                members = self.local_store[victim]
+                index = members[self.rng.randint(0, len(members)-1)]
+                self.local_count[victim] -= 1
+                self.local_count[c] = self.local_count.get(c, 0)+1
+                self.local_store[victim].remove(index)
+                self.local_store.setdefault(c, []).append(index)
+            else:
+                if self.rng.uniform(0, 1) > self.local_count[c]/self.encounters[c]:
+                    continue
+                # Upstream chooses the first stored slot, not a uniform slot.
+                index = self.local_store[c][0]
+            self.rows[index], self.labels[index] = row, c
+
+    def sample(self, size):
+        if not isinstance(size, int) or size < 0:
+            raise ValueError('nonnegative integer replay size required')
+        n = min(size, len(self.rows))
+        if not n:
+            return np.empty(0, dtype=np.int64), np.empty(0, dtype=np.int64)
+        maximum = max(self.global_priority.values(), default=None)
+        weights = [1. if c in self.global_priority and self.global_priority[c] == maximum
+            and self.local_count[c] == .1*self.capacity else 1/self.local_count[c] for c in self.labels]
+        weights = np.asarray(weights, dtype=float)
+        indices = self.np_rng.choice(len(self.rows), n, replace=False, p=weights/weights.sum())
+        return np.asarray(self.rows, dtype=np.int64)[indices], np.asarray(self.labels, dtype=np.int64)[indices]
+
+    def state(self):
+        rng = self.np_rng.get_state()
+        return copy.deepcopy(dict(capacity=self.capacity, rows=self.rows, labels=self.labels,
+            local_count=self.local_count, local_store=self.local_store, encounters=self.encounters,
+            full=sorted(self.full), global_priority=self.global_priority,
+            rng=self.rng.getstate(), np_rng=[rng[0], rng[1].tolist(), rng[2], rng[3], rng[4]], semantics=SEMANTICS))
+
+    @classmethod
+    def restore(cls, state):
+        state = copy.deepcopy(state)
+        if state['semantics'] != SEMANTICS:
+            raise ValueError('memory semantics changed')
+        obj = cls(state['capacity'])
+        for k in ['rows', 'labels', 'local_count', 'local_store', 'encounters', 'global_priority']:
+            setattr(obj, k, state[k])
+        obj.full = set(state['full'])
+        obj.rng.setstate(state['rng'])
+        s = state['np_rng']
+        obj.np_rng.set_state((s[0], np.asarray(s[1], dtype=np.uint32), s[2], s[3], s[4]))
+        assert len(obj.rows) == len(obj.labels) <= obj.capacity
+        assert set(obj.local_count) <= set(obj.encounters)
+        assert obj.full <= set(obj.local_count)
+        for c, count in obj.local_count.items():
+            assert count == obj.labels.count(c) == len(obj.local_store[c])
+            assert all(obj.labels[i] == c for i in obj.local_store[c])
+        assert sorted(i for ids in obj.local_store.values() for i in ids) == list(range(len(obj.rows)))
+        return obj
