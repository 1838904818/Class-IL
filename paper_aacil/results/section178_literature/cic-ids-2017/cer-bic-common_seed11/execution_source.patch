+"""Section 192 common-budget override; native implementation stays immutable."""
+from copy import deepcopy
+import math
+import time
+import numpy as np
+import torch
+from ncd.cer_bic import FlowBiC, partition_current, fit_bias, bic_loss, tensor_batch
+from ncd.cer_bic import MAPPING as NATIVE_MAPPING
+
+MAPPING = deepcopy(NATIVE_MAPPING)
+MAPPING['training_override'] = {
+    'authority': 'WORK_ORDER sections 189, 191.3 and 192; e9c11b95baf896fe3b31ec0fa6a47a33f473bf07',
+    'reason': 'CIC17 native seed10 stopped at 3304.719 s before first task completion; not an algorithm performance result.',
+    'stage1': 'Adam lr 0.001, batch 256, max(8 full epochs, 2000 optimizer steps), no early stopping or learning-rate decay; final iterate.',
+    'stage2': 'Separate BiC correction unchanged: SGD lr 0.1 momentum 0.9, 200 epochs, beta penalty 0.05; reported separately.',
+    'family': 'All new CER formal cells use this override; native UNSW remains historical sensitivity evidence, never mixed into this family.',
+    'rows': 'Same partition as native; reserved TRAIN stopping rows retained for diagnostic loss only, not model selection.'
+}
+MAPPING['engineering_defaults'].update(optimizer='Adam', momentum=None, weight_decay=0.)
+
+def target_steps(rows, smoke=False):
+    if rows <= 0:
+        raise ValueError('Empty stage-1 training pool')
+    batches = math.ceil(rows/256)
+    return batches if smoke else max(8*batches, 2000)
+
+def fit_backbone(model, teacher, x, y, fit, stop, seed, smoke, progress, identity, ps):
+    """Fixed common-budget stage 1; reserved stopping rows are diagnostic only."""
+    n_old = sum(len(g) for g in teacher.groups) if teacher is not None else 0
+    model.requires_grad_(True)
+    for p in list(model.scales)+list(model.offsets):
+        p.requires_grad_(False)
+    optimizer = torch.optim.Adam([p for p in model.parameters() if p.requires_grad], lr=.001)
+    best, best_loss, patience, steps, elapsed, begin_epoch = deepcopy(model.state_dict()), float('inf'), 20, 0, 0., 0
+    target = target_steps(len(fit), smoke)
+    history = []
+    if progress.exists():
+        state = ps.checkpoint_load(progress, identity)
+        model.load_state_dict(state['model'])
+        optimizer.load_state_dict(state['optimizer'])
+        best, best_loss, patience, steps, elapsed = (state[k] for k in ['best', 'best_loss', 'patience', 'steps', 'seconds'])
+        history, begin_epoch = state['history'], state['next_epoch']
+        if state['done']:
+            model.load_state_dict(best)
+            return dict(epochs=len(history), optimizer_steps=steps, seconds=elapsed, history=history)
+    for epoch in range(begin_epoch, math.ceil(target/math.ceil(len(fit)/256))):
+        start = time.perf_counter()
+        model.train()
+        shuffled = np.random.default_rng(seed+epoch*1009).permutation(fit)
+        epoch_steps = 0
+        for offset in range(0, len(shuffled), 256):
+            if steps >= target:
+                break
+            bx, by = tensor_batch(x, y, shuffled[offset:offset+256])
+            with torch.no_grad():
+                old = teacher(bx) if teacher is not None else None
+            optimizer.zero_grad(set_to_none=True)
+            loss = bic_loss(model(bx), by, old, n_old)
+            if not torch.isfinite(loss):
+                raise ValueError('Nonfinite BiC stage-1 loss')
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 10000.)
+            optimizer.step()
+            steps += 1
+            epoch_steps += 1
+        model.eval()
+        total = 0.
+        with torch.no_grad():
+            for offset in range(0, len(stop), 256):
+                ids = stop[offset:offset+256]
+                bx, by = tensor_batch(x, y, ids)
+                old = teacher(bx) if teacher is not None else None
+                total += float(bic_loss(model(bx), by, old, n_old))*len(ids)
+        measured = total/len(stop)
+        if not math.isfinite(measured):
+            raise ValueError('Nonfinite stopping loss')
+        # Common fixed training uses the final iterate, not stopping-set selection.
+        best_loss, best = measured, deepcopy(model.state_dict())
+        done = steps == target
+        elapsed += time.perf_counter()-start
+        history.append(dict(epoch=epoch+1, validation_loss=measured, lr=.001, optimizer_steps=epoch_steps))
+        ps.checkpoint_save(progress, dict(identity=identity, model=model.state_dict(), optimizer=optimizer.state_dict(),
+            best=best, best_loss=best_loss, patience=patience, steps=steps, seconds=elapsed, history=history,
+            next_epoch=epoch+1, done=done))
+        print(f'BIC_BACKBONE epoch={epoch+1} steps={steps} validation_loss={measured:.8g} seconds={elapsed:.2f}', flush=True)
+        if done:
+            break
+    model.load_state_dict(best)
+    return dict(epochs=len(history), optimizer_steps=steps, seconds=elapsed, history=history)
