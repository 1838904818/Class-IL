+import json
+import unittest
+import numpy as np
+from ncd.ecbrs_memory import PaperECBRS
+
+
+class TestPaperECBRS(unittest.TestCase):
+    def test_literal_gamma_and_large_count_stability(self):
+        m = PaperECBRS(12)
+        m.encounters = {0: 10**12 + 2, 1: 10**12 + 1}
+        g = m.gamma()
+        self.assertAlmostEqual(sum(g.values()), 12)
+        self.assertAlmostEqual(g[1] / g[0], np.e)
+
+    def test_capacity_full_status_and_all_seen_counters(self):
+        m = PaperECBRS(4)
+        for i in range(100):
+            m.offer(i, 0 if i < 80 else 1)
+        self.assertEqual(len(m.rows), 4)
+        self.assertEqual(m.encounters, {0: 80, 1: 20})
+        self.assertIn(0, m.full)
+        self.assertIn(1, m.full)
+        self.assertEqual(len(set(m.rows)), 4)
+
+    def test_nonfull_global_majority_victim_not_local_maximum(self):
+        m = PaperECBRS(8, seed=1)
+        m.rows, m.labels = list(range(8)), [0]*3 + [1]*5
+        m.encounters, m.full = {0: 100, 1: 20}, {0, 1}
+        event = m.offer(8, 2)
+        self.assertEqual(event, {'admitted': True, 'victim_class': 0})
+        self.assertEqual(m.counts(), {0: 2, 1: 5, 2: 1})
+
+    def test_budget_growth_does_not_revisit_past_rows(self):
+        m = PaperECBRS(2, seed=3)
+        for i in range(10):
+            m.offer(i, 0)
+        old = list(m.rows)
+        m.grow(4)
+        self.assertEqual(m.rows, old)
+        m.offer(10, 1)
+        self.assertEqual(len(m.rows), 3)
+        with self.assertRaises(ValueError):
+            m.grow(3)
+
+    def test_resume_exact_rng_and_payload(self):
+        first = PaperECBRS(13, seed=15)
+        for i in range(100):
+            first.offer(i, i % 4)
+        resumed = PaperECBRS.restore(json.loads(json.dumps(first.state())))
+        for i in range(100, 200):
+            self.assertEqual(first.offer(i, i % 7), resumed.offer(i, i % 7))
+            a, b = first.sample(5), resumed.sample(5)
+            np.testing.assert_array_equal(a[0], b[0])
+            np.testing.assert_array_equal(a[1], b[1])
+        self.assertEqual(first.state(), resumed.state())
+
+    def test_sample_never_fabricates_or_duplicates_slots(self):
+        m = PaperECBRS(9)
+        for i in range(100):
+            m.offer(i, i % 3)
+        rows, labels = m.sample(100)
+        self.assertEqual(len(rows), 9)
+        self.assertEqual(len(set(rows)), 9)
+        self.assertEqual(set(zip(rows, labels)), set(zip(m.rows, m.labels)))
+
+    def test_invalid_restore_rejected(self):
+        m = PaperECBRS(2)
+        m.offer(1, 0)
+        state = m.state()
+        state['encounters'][0] = 0
+        with self.assertRaises(ValueError):
+            PaperECBRS.restore(state)
+
+
+if __name__ == '__main__':
+    unittest.main()
