           'quantitative_gate':len(rr)>=2,'mean_gap_times_count':sum(gaps) if gaps else 0})
out['quantitative_metric_gates']=sorted(gates,key=lambda r:-r['mean_gap_times_count'])
print(json.dumps(out,indent=2,allow_nan=False))
