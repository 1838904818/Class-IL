import sys,json,math,hashlib
from pathlib import Path
from collections import defaultdict
P=Path.cwd()
W=P.parent
SEEDS=(1,2,3,4,42)
METHODS=('joint','replay','icarl','replay_lwf','rcl_tab','derpp')
DATASETS=('NSL-KDD','UNSW-NB15','CIC-IDS-2017','CSE-CIC-IDS2018')
locations=[(P/'ncd/results/problem_scout/section21/formal_v1', {'NSL-KDD','UNSW-NB15'})]
locations += [(W/f'exp_h_section21_data/hpc_raw/cic17/seed_{s}/all',{'CIC-IDS-2017'}) for s in (1,2,3)]
locations += [(P/f'ncd/results/problem_scout/section21/local_tail_v1/cic17/seed_{s}/all',{'CIC-IDS-2017'}) for s in (4,42)]
locations += [(W/f'exp_h_section21_data/hpc_raw/cic18/seed_{s}/all',{'CSE-CIC-IDS2018'}) for s in (1,2,3,4)]
locations += [(P/'ncd/results/problem_scout/section21/local_tail_v1/cic18/seed_42/all',{'CSE-CIC-IDS2018'})]
cells={}
inputs=[]
for root,allowed in locations:
    assert root.is_dir(),str(root)
    for path in sorted(root.rglob('result.json')):
        raw=path.read_bytes(); c=json.loads(raw)
        if 'identity' not in c or c['identity']['dataset'] not in allowed: continue
        ident=c['identity']; key=(ident['dataset'],ident['method'],int(ident['seed']))
        assert key not in cells, key
        assert c['completed'] and not ident['effective_config']['smoke']
        assert ident['effective_config']['epochs_per_task']==8
        cells[key]=c
        inputs.append({'key':key,'path':path.relative_to(W).as_posix(),'sha256':hashlib.sha256(raw).hexdigest()})
assert set(cells)=={(d,m,s) for d in DATASETS for m in METHODS for s in SEEDS}
issues=[]; checked_numbers=0
def near(actual,expect,context):
    global checked_numbers
    checked_numbers+=1
    if actual is None or expect is None:
        if actual is not expect: issues.append((context,actual,expect))
    elif isinstance(actual,(int,float)) and isinstance(expect,(int,float)):
        if not math.isclose(actual,expect,rel_tol=2e-12,abs_tol=2e-12):issues.append((context,actual,expect))
    elif actual!=expect: issues.append((context,actual,expect))
def calc(cp,mode,nclasses):
    q=cp[mode]; a=q['confusion_matrix']; labels=q['confusion_labels']
    assert labels==list(range(nclasses))
    assert len(a)==nclasses and all(len(r)==nclasses for r in a)
    assert all(type(x) is int and x>=0 for r in a for x in r)
    row=[sum(r) for r in a]; col=[sum(r[j] for r in a) for j in range(nclasses)]
    seen=cp['seen_classes']
    assert sorted(x['class_id'] for x in q['per_class'])==sorted(seen)
    recall=[a[i][i]/row[i] if row[i] else None for i in range(nclasses)]
    f1=[2*a[i][i]/(row[i]+col[i]) if row[i]+col[i] else 0.0 for i in range(nclasses)]
    valid=[recall[i] for i in seen if recall[i] is not None]
    attack=sum(row[i] for i in seen if i!=0)
    detected=sum(a[i][j] for i in seen if i!=0 for j in range(nclasses) if j!=0)
    r={'macro_f1':sum(f1[i] for i in seen)/len(seen),
       'balanced_accuracy':sum(valid)/len(valid) if valid else None,
       'attack_recall':detected/attack if attack else None,
       'normal_fpr':(row[0]-a[0][0])/row[0] if row[0] else None,
       'recall':recall,'matrix':a,'support':row}
    near(sum(row),q['evaluated_rows'],'evaluated_rows')
    for field in ('macro_f1','balanced_accuracy','attack_recall','normal_fpr'):near(q[field],r[field],field)
    for rec in q['per_class']:
        i=rec['class_id']
        near(rec['support'],row[i],'support')
        near(rec['recall'],recall[i],'recall')
        near(rec['f1'],f1[i],'f1')
        near(rec['precision'],a[i][i]/col[i] if col[i] else None,'precision')
    return r
derived={}
for key,c in sorted(cells.items()):
    n=len(c['class_order'])
    derived[key]={}
    for cp in c['checkpoints']:
        idx=cp['task_index']; modes={}
        for mode in ('id','shift'):
            if cp.get(mode) is not None:modes[mode]=calc(cp,mode,n)
        derived[key][idx]=modes
assert not issues,issues[:10]
def avg(x):return sum(x)/len(x)
def sdesc(x):
    mu=avg(x)
    return {'mean':mu,'sample_sd':math.sqrt(sum((z-mu)**2 for z in x)/(len(x)-1)),
            'by_seed':dict(zip(map(str,SEEDS),x))}
def compare(v,higher=True):
    if any(x is None for x in v['joint']):return None
    eligible=[m for m in METHODS if m!='joint' and all(x is not None for x in v[m])]
    if not eligible:return None
    win=sorted(eligible,key=lambda m:((-1 if higher else 1)*avg(v[m]),m))[0]
    gaps=[(1 if higher else -1)*(a-b) for a,b in zip(v['joint'],v[win])]
    return {'best_cil_method':win,'joint':sdesc(v['joint']),'best_cil':sdesc(v[win]),
            'gap_pp':sdesc([100*x for x in gaps]),
            'gap_positive_all_five_seeds':all(x>0 for x in gaps),
            'mean_gap_at_least_5pp':avg(gaps)>=.05,
            'direction':'Joint minus CIL' if higher else 'CIL minus Joint'}
def vals(d,field,mode='id',cid=None):
    ans={}
    for m in METHODS:
        ans[m]=[]
        for s in SEEDS:
            stages=derived[d,m,s]; final=stages[max(stages)][mode]
            ans[m].append(final[field][cid] if cid is not None else final[field])
    return ans
manual={g:[] for g in ('G1','G2','G3','G4','G5','G6','G7')}
for d in DATASETS:
    ex=cells[d,'joint',1]; classes=ex['class_order']; tasks=ex['tasks']
    born={cid:t for t,g in enumerate(tasks) for cid in g}
    for metric in ('macro_f1','balanced_accuracy'):
        manual['G1'].append({'dataset':d,'metric':metric,'comparison':compare(vals(d,metric))})
    for metric in ('attack_recall','normal_fpr'):
        manual['G5'].append({'dataset':d,'metric':metric,'comparison':compare(vals(d,metric),metric!='normal_fpr')})
    for cid,name in enumerate(classes):
        ct=ex['train_counts']; n=ct.get(name,ct.get(str(cid)))
        manual['G2'].append({'dataset':d,'class_id':cid,'class_name':name,'train_count':n,
          'train_count_bucket':'<1k' if n<1000 else '1k-10k' if n<=10000 else '>10k',
          'comparison':compare(vals(d,'recall',cid=cid))})
        if d=='CIC-IDS-2017':
            manual['G6'].append({'dataset':d,'class_id':cid,'class_name':name,
              'comparison':compare(vals(d,'recall','shift',cid)),
              'qualification':'One source dataset only; cannot alone satisfy the two-dataset candidate gate'})
    for m in METHODS:
        for s in SEEDS:
            c=cells[d,m,s]; stages=derived[d,m,s]; last=stages[max(stages)]['id']
            for cid,name in enumerate(classes):
                own=stages[born[cid]]['id']['recall'][cid]; final=last['recall'][cid]
                base={'dataset':d,'method':m,'seed':s,'class_id':cid,'class_name':name}
                manual['G3'].append({**base,'own_task_index':born[cid],'own_task_recall':own,'final_recall':final,
                     'own_minus_final_recall_pp':None if own is None or final is None else 100*(own-final)})
                a=last['matrix']; n=sum(a[cid]); err=n-a[cid][cid]
                normal=a[cid][0] if cid else 0
                newer=sum(a[cid][j] for j in range(len(classes)) if j!=cid and j!=0 and born[j]>born[cid])
                counts={'normal':normal,'newer_classes':newer,'other_old_or_same_task':err-normal-newer}
                manual['G4'].append({**base,'is_old_at_final':born[cid]<len(tasks)-1,
                   'support':n,'errors':err,'counts':counts,
                   'fraction_of_true_class':{k:v/n if n else None for k,v in counts.items()},
                   'fraction_of_errors':{k:v/err if err else None for k,v in counts.items()}})
            cps=c['checkpoints']
            costs={f:sum(cp[f] for cp in cps) for f in ('training_seconds','evaluation_seconds','buffer_selection_seconds')}
            near(c['training_seconds_total'],costs['training_seconds'],'cumulative train')
            assert all(type(cp[f]) in (int,float) and math.isfinite(cp[f]) and cp[f]>=0 for cp in cps for f in ('training_seconds','evaluation_seconds','buffer_selection_seconds','replay_bytes_after','replay_allocated_bytes_after'))
            manual['G7'].append({'dataset':d,'method':m,'seed':s,'training_seconds_total':costs['training_seconds'],
                'evaluation_seconds_total':costs['evaluation_seconds'],'buffer_selection_seconds_total':costs['buffer_selection_seconds'],
                'peak_cuda_allocated_bytes':max((cp['peak_cuda_allocated_bytes'] for cp in cps if cp['peak_cuda_allocated_bytes'] is not None),default=None),
                'peak_cuda_reserved_bytes':max((cp['peak_cuda_reserved_bytes'] for cp in cps if cp['peak_cuda_reserved_bytes'] is not None),default=None),
                'maximum_replay_bytes':max(cp['replay_bytes_after'] for cp in cps),
                'maximum_replay_allocated_bytes':max(cp['replay_allocated_bytes_after'] for cp in cps),
                'cost_scope':'Cumulative successful checkpoint training with separate evaluation/selection totals; failed-attempt walltime requires separate logs'})
# Load the saved production output only after all independent results were calculated.
# No production analyzer or helper is imported/called.
automated=json.loads((P/'ncd/results/problem_scout/section21/analysis_v1.json').read_bytes())
def cmp(a,b,path):
    if isinstance(a,dict):
        assert set(a)==set(b),(path,set(a)^set(b))
        for k in a:cmp(a[k],b[k],path+'/'+str(k))
    elif isinstance(a,list):
        assert len(a)==len(b),(path,len(a),len(b))
        for i,(x,y) in enumerate(zip(a,b)):cmp(x,y,path+'/'+str(i))
    else:near(a,b,path)
keys={'G1':('dataset','metric'),'G2':('dataset','class_id'),'G3':('dataset','method','seed','class_id'),
      'G4':('dataset','method','seed','class_id'),'G5':('dataset','metric'),'G6':('dataset','class_id'),
      'G7':('dataset','method','seed')}
for g,keyfields in keys.items():
    k=lambda r:tuple(r[f] for f in keyfields)
    cmp(sorted(manual[g],key=k),sorted(automated[g],key=k),g)
assert not issues,issues[:10]
out={'verification':{'selected_cells':len(cells),'checkpoints':sum(len(c['checkpoints']) for c in cells.values()),
    'final_rows_including_shift':sum(len(c['checkpoints'][-1][mode]['per_class']) for c in cells.values() for mode in ('id','shift') if c['checkpoints'][-1].get(mode) is not None),
    'compared_scalar_values':checked_numbers,'issues':issues,'G_counts':{g:len(manual[g]) for g in manual},
    'selection_manifest_sha256':hashlib.sha256(json.dumps(sorted(inputs,key=lambda x:x['key']),sort_keys=True,separators=(',',':')).encode()).hexdigest(),
    'analyzer_sha256':hashlib.sha256((P/'ncd/analyze_problem_scout.py').read_bytes()).hexdigest()},
    'G1':manual['G1'],'G5':manual['G5'],'G2':[],'G6':[],'G3_selected':[],'G4_selected':[],'G7_summary':[]}
for g in ('G2','G6'):
    for r in manual[g]:
        c=r['comparison']
        out[g].append({k:v for k,v in r.items() if k!='comparison'}|({'comparison':None} if c is None else
           {'best':c['best_cil_method'],'joint_mean':c['joint']['mean'],'cil_mean':c['best_cil']['mean'],
            'gap_pp':c['gap_pp'],'positive_all5':c['gap_positive_all_five_seeds'],'gap_ge5':c['mean_gap_at_least_5pp']}))
for d in DATASETS:
    win=next(r['comparison']['best_cil_method'] for r in manual['G1'] if r['dataset']==d and r['metric']=='macro_f1')
    ex=cells[d,win,1]; tasks=ex['tasks']
    for cid,name in enumerate(ex['class_order']):
        rows=[r for r in manual['G3'] if r['dataset']==d and r['method']==win and r['class_id']==cid]
        out['G3_selected'].append({'dataset':d,'fixed_macroF1_best':win,'class':name,'own_mean':avg([r['own_task_recall'] for r in rows]),
              'final_mean':avg([r['final_recall'] for r in rows]),'drop_pp':sdesc([r['own_minus_final_recall_pp'] for r in rows])})
    rows=[r for r in manual['G4'] if r['dataset']==d and r['method']==win and r['is_old_at_final']]
    for scope in ('all_old','old_attack'):
        rr=[r for r in rows if scope=='all_old' or r['class_id']!=0]
        counts={k:sum(r['counts'][k] for r in rr) for k in ('normal','newer_classes','other_old_or_same_task')}
        support=sum(r['support'] for r in rr); errors=sum(counts.values())
        out['G4_selected'].append({'dataset':d,'fixed_macroF1_best':win,'scope':scope,'support_5seeds':support,'errors_5seeds':errors,
                'counts_5seeds':counts,'percent_true_support':{k:100*v/support for k,v in counts.items()},
                'percent_errors':{k:100*v/errors if errors else None for k,v in counts.items()}})
    for m in METHODS:
        rr=[r for r in manual['G7'] if r['dataset']==d and r['method']==m]
        out['G7_summary'].append({'dataset':d,'method':m,
           **{f:sum(r[f] for r in rr) for f in ('training_seconds_total','evaluation_seconds_total','buffer_selection_seconds_total')},
           **{f:max(r[f] for r in rr if r[f] is not None) for f in ('peak_cuda_allocated_bytes','peak_cuda_reserved_bytes','maximum_replay_bytes','maximum_replay_allocated_bytes')}})
out['G7_totals']={f:sum(r[f] for r in manual['G7']) for f in ('training_seconds_total','evaluation_seconds_total','buffer_selection_seconds_total')}
# Quantitative gates only. Literature qualification and problem grouping remain separate.
gates=[]
