{
  "dataset": "NSL-KDD",
  "method": "replay",
  "seed": 1,
  "data_root": "../kaggle_leon_release/datasets",
  "device": "cuda",
  "hidden": 128,
  "batch_size": 256,
  "epochs_per_task": 8,
  "learning_rate": 0.001,
  "buffer_per_class": 200,
  "target_class": 0,
  "transition_before": 0,
  "marker_columns": 4,
  "rho_values": [0.5, 0.7, 0.9, 1.0],
  "probe_per_class": 200,
  "background_rows": 100,
  "repeats": 10,
  "bootstraps": 10,
  "expected_gradients_nsamples": 32,
  "permutations": 1000,
  "top_k": 15,
  "fixed_jaccard_threshold": 0.70,
  "silent_recall_drop": 0.05,
  "truth_recall_drop": 0.05,
  "checkpoint0_max_marker_effect": 0.01,
  "output_dir": "ncd/results/exp2/nsl-kdd/replay/seed1",
  "log_path": "ncd/logs/exp2_nsl_replay_seed1.log"
}
